# Copy to .env (`make env` does it and generates random secrets for every
# value equal to "change_me"). The .env file is git-ignored.

COMPOSE_PROJECT_NAME=pgmon

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
# Application role (order-api, worker)
APP_DB_USER=app
APP_DB_PASSWORD=change_me
# Load generator role (background jobs, chaos)
GENERATOR_DB_USER=generator
GENERATOR_DB_PASSWORD=change_me
# Monitoring role used by postgres-exporter (member of pg_monitor)
EXPORTER_DB_USER=exporter
EXPORTER_DB_PASSWORD=change_me

# --- Authorization (auth service) --------------------------------------------
# Accounts created on first start. Log in at http://localhost/login
AUTH_ADMIN_USER=admin
AUTH_ADMIN_PASSWORD=change_me
AUTH_VIEWER_USER=viewer
AUTH_VIEWER_PASSWORD=change_me
# Service account used by the load generator (API only, no UI access)
AUTH_SERVICE_USER=loadgen
AUTH_SERVICE_PASSWORD=change_me
# HMAC key for signing JWTs
JWT_SECRET=change_me

# --- Public entry point ------------------------------------------------------
HTTP_PORT=80
PUBLIC_URL=http://localhost

# --- Grafana -----------------------------------------------------------------
# Password of Grafana's internal admin account. It cannot be used to log in
# (Grafana login form and basic auth are disabled); kept only because Grafana
# requires one.
GRAFANA_ADMIN_PASSWORD=change_me

# --- Load generator ----------------------------------------------------------
# Number of virtual shoppers and target aggregate request rate
USERS=20
RPS=10

# --- RabbitMQ ----------------------------------------------------------------
RABBITMQ_USER=shop
RABBITMQ_PASSWORD=change_me
